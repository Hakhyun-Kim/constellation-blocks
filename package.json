{
  "name": "constellation-defense",
  "version": "2.1.0",
  "description": "A real-time match-3 tactics defense game built with Codex.",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "esbuild src/main.js --bundle --outfile=dist/game.js --format=iife --minify-whitespace",
    "watch": "esbuild src/main.js --bundle --outfile=dist/game.js --format=iife --watch",
    "serve": "node scripts/serve.mjs",
    "check": "npm run build"
  },
  "dependencies": {
    "three": "^0.166.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
